{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml"
  xmlns:video="http://www.google.com/schemas/sitemap-video/1.1">

  {{- /* ==================== HOMEPAGE ==================== */ -}}
  {{- with .Site.Home }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
    {{- end }}
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  {{- end }}

  {{- /* ==================== ALL PAGES (unified, no duplicates) ==================== */ -}}
  {{- range .Site.Pages }}
    {{- if and (not .Draft) (ne .Kind "home") (not (partial "seo/noindex.html" .)) .Permalink }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- /* --- Lastmod: page date, or latest child date for taxonomy/section pages --- */ -}}
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
    {{- else if .Pages }}
      {{- $sorted := sort .Pages ".Lastmod" "desc" }}
      {{- with index $sorted 0 }}
        {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
        {{- end }}
      {{- end }}
    {{- end }}
    {{- /* --- Priority & Changefreq by content type (driven by Hugo sections) --- */ -}}
    {{- $sec := "" }}{{- with .CurrentSection }}{{ $sec = .Title }}{{ end }}
    {{- if and (eq .Kind "page") (eq $sec "Experiences") }}
    <changefreq>monthly</changefreq>
    <priority>0.95</priority>
    {{- else if and (eq .Kind "page") (eq $sec "Tech Projects") }}
    <changefreq>monthly</changefreq>
    <priority>0.90</priority>
    {{- else if and (eq .Kind "page") (eq $sec "Thoughts") }}
    <changefreq>monthly</changefreq>
    <priority>0.85</priority>
    {{- else if and (eq .Kind "page") (eq $sec "Publications") }}
    <changefreq>monthly</changefreq>
    <priority>0.80</priority>
    {{- else if and (eq .Kind "page") (eq .Section "passion") }}
    <changefreq>monthly</changefreq>
    <priority>0.75</priority>
    {{- else if and (eq .Kind "page") (eq $sec "Books") }}
    <changefreq>monthly</changefreq>
    <priority>0.70</priority>
    {{- else if eq .Kind "page" }}
    <changefreq>monthly</changefreq>
    <priority>0.65</priority>
    {{- else if eq .Kind "section" }}
    <changefreq>weekly</changefreq>
    <priority>0.55</priority>
    {{- else if or (eq .Kind "taxonomy") (eq .Kind "term") }}
    <changefreq>weekly</changefreq>
    <priority>0.50</priority>
    {{- else }}
    <changefreq>monthly</changefreq>
    <priority>0.50</priority>
    {{- end }}
    {{- /* Only actual individual embeds, shared with VideoObject JSON-LD. */ -}}
    {{- range partial "seo/videos.html" . }}
    <video:video>
      <video:thumbnail_loc>{{ .thumbnail }}</video:thumbnail_loc>
      <video:title>{{ .name }}</video:title>
      <video:description>{{ .description }}</video:description>
      <video:player_loc>{{ .embed_url }}</video:player_loc>
      <video:publication_date>{{ .upload_date }}</video:publication_date>
    </video:video>
    {{- end }}
  </url>
    {{- end }}
  {{- end }}
</urlset>
